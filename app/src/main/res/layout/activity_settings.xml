<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/PmTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings" />

        <TextView
            style="@style/PmSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Make the app yours" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/pm_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/PmSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFILE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Your name"
                    android:textColor="@color/pm_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Shown in the Home greeting"
                    android:inputType="textPersonName|textCapWords"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Alerts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/pm_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/PmSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALERTS" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Expiring-soon alerts"
                    android:textColor="@color/pm_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/PmSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Show a warning on the Pantry screen for items that expire within 3 days."
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Preferences -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/pm_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/PmSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREFERENCES" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Default unit for new ingredients"
                    android:textColor="@color/pm_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spDefaultUnit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Sample data -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/pm_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/PmSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAMPLE DATA" />

                <TextView
                    style="@style/PmSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Fill the pantry with demo ingredients to try the app, or empty it to start fresh."
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnLoadSample"
                    style="@style/PmButton"
                    android:layout_marginTop="14dp"
                    android:text="Load sample pantry" />

                <TextView
                    android:id="@+id/btnClearPantry"
                    style="@style/PmButtonOutline"
                    android:layout_marginTop="10dp"
                    android:text="Clear pantry" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:itemIconTint="@color/pm_nav_colors"
        app:itemTextColor="@color/pm_nav_colors"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/pm_bottom_nav" />

</LinearLayout>
